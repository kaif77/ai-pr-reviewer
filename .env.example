# .env.example — copy to .env and fill in your values

# GitHub fine-grained PAT
# Permissions: Pull requests (read/write), Contents (read), Metadata (read)
# Create at: github.com → Settings → Developer Settings → Fine-grained tokens
GITHUB_TOKEN=github_pat_xxxxxxxxxx

# Node version to activate via nvm
# Run `nvm ls` to see installed versions
NODE_VERSION=v22.14.0
